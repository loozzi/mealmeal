# Bắt buộc. API key của nhà cung cấp AI. Chỉ dùng ở server.
OPENAI_API_KEY=
# Tùy chọn. Đổi endpoint khi dùng nhà cung cấp tương thích OpenAI. Bỏ trống = OpenAI.
OPENAI_BASE_URL=
# Bắt buộc. Tên model, phải đọc được ảnh (vision).
AI_MODEL=
# Tùy chọn. json_schema (mặc định) hoặc json_object cho nhà cung cấp không hỗ trợ structured output.
AI_JSON_MODE=json_schema
# Tùy chọn. Upstash Redis cho giới hạn lượt gọi trên production. Thiếu thì dùng bộ đếm trong bộ nhớ.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Bắt buộc. Cấu hình web app Firebase (Project settings → Your apps). Công khai, không phải bí mật.
# Project id bắt đầu bằng `demo-` thì app dùng Firebase emulator (chỉ cho test).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
